# Clash 配置文件
mixed-port: 7890
socks-port: 7891
redir-port: 7892
allow-lan: true
mode: rule
log-level: info
external-controller: 0.0.0.0:9090
secret: ""
ipv6: false

# 启用TUN模式
tun:
  enable: false
  stack: system
  auto-route: true
  auto-detect-interface: true

# DNS设置
dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  fallback:
    - tls://1.1.1.1
    - https://dns.google/dns-query

# 节点配置 (已修正缩进和格式)
proxies:
  - name: "TUIC-bitterzhou"
    type: tuic
    server: 198.46.145.251
    port: 7777
    uuid: c3e44804-5149-4bfe-9a33-d5051af3c65e
    password: c3e44804-5149-4bfe-9a33-d5051af3c65e
    alpn: [h3]
    reduce-rtt: true
    udp-relay-mode: native
    congestion-controller: bbr
    skip-cert-verify: true
    sni: www.apple.com

  - name: "Shadowsocks-2022-dedirock-96354141"
