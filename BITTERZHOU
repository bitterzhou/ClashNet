# Clash 配置文件 - 已修正版
mixed-port: 7890
allow-lan: true
mode: rule
log-level: info
external-controller: 0.0.0.0:9090
ipv6: false

dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  fallback:
    - tls://1.1.1.1
    - https://dns.google/dns-query

proxies:
  - name: "TUIC-bitterzhou"
    type: tuic
    server: 198.46.145.251
    port: 7777
    uuid: c3e44804-5149-4bfe-9a33-d5051af3c65e
    password: c3e44804-5149-4bfe-9a33-d5051af3c65e
    alpn: [h3]
    reduce-rtt: true
    udp-relay-mode: native
    congestion-controller: bbr
    skip-cert-verify: true
    sni: www.apple.com

  - name: "BITTER-SERVER-1-hy2"
    type: hysteria2
    server: 192.227.229.51
    port: 28133
    password: c3e44804-5149-4bfe-9a33-d5051af3c65e
    sni: "www.apple.com"
    skip-cert-verify: true

  - name: "BITTER-SERVER-2-hy2"
    type: hysteria2
    server: 66.154.113.16
    port: 7001
    password: e9a98960-e28b-434d-984d-c0aee9df8978
    sni: "www.apple.com"
    skip-cert-verify: true

proxy-groups:
  - name: "TUIC代理"
    type: select
    proxies:
      - "TUIC-bitterzhou"
      - "BITTER-SERVER-1-hy2"
      - "BITTER-SERVER-2-hy2"
      - DIRECT

  - name: "AI服务"
    type: select
    proxies:
      - "TUIC代理"
      - DIRECT

  - name: "国外媒体"
    type: select
    proxies:
      - "TUIC代理"

  - name: "国外网站"
    type: select
    proxies:
      - "TUIC代理"

  - name: "国内直连"
    type: select
    proxies:
      - DIRECT
      - "TUIC代理"

  - name: "广告拦截"
    type: select
    proxies:
      - REJECT
      - DIRECT

rules:
  # 局域网直连
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT
  - IP-CIDR,192.168.0.0/16,DIRECT
  
  # 广告屏蔽
  - DOMAIN-KEYWORD,adservice,广告拦截
  - DOMAIN-SUFFIX,googleadservices.com,广告拦截
  
  # AI服务
  - DOMAIN-SUFFIX,openai.com,AI服务
  - DOMAIN-SUFFIX,chat.openai.com,AI服务
  - DOMAIN-SUFFIX,anthropic.com,AI服务
  - DOMAIN-SUFFIX,claude.ai,AI服务
  
  # 流媒体
  - DOMAIN-SUFFIX,netflix.com,国外媒体
  - DOMAIN-SUFFIX,youtube.com,国外媒体
  - DOMAIN-SUFFIX,googlevideo.com,国外媒体
  
  # 社交与国外网站
  - DOMAIN-SUFFIX,twitter.com,国外网站
  - DOMAIN-SUFFIX,telegram.org,国外网站
  - DOMAIN-SUFFIX,github.com,国外网站
  - DOMAIN-SUFFIX,google.com,国外网站
  
  # 国内直连
  - DOMAIN-SUFFIX,qq.com,国内直连
  - DOMAIN-SUFFIX,baidu.com,国内直连
  - GEOIP,CN,国内直连

  # 最终兜底
  - MATCH,TUIC代理
