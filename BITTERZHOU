# 代理组配置 (已修正节点名称引用)
proxy-groups:
  - name: "TUIC代理"
    type: select
    proxies:
      - "TUIC-bitterzhou"
      - "Shadowsocks-2022-dedirock-96354141"
      - "hy2-dedirock-96354141"
      - "tuic-dedirock-96354141"
      - DIRECT

  - name: "广告拦截"
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: "国内直连"
    type: select
    proxies:
      - DIRECT

  - name: "AI服务"
    type: select
    proxies:
      - "TUIC代理"
      - DIRECT

  - name: "国外媒体"
    type: select
    proxies:
      - "TUIC代理"
      - DIRECT

  - name: "国外网站"
    type: select
    proxies:
      - "TUIC代理"
      - DIRECT

# 规则配置
rules:
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT
  - IP-CIDR,172.16.0.0/12,DIRECT
  - IP-CIDR,192.168.0.0/16,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT
  - DOMAIN-KEYWORD,adservice,广告拦截
  - DOMAIN-SUFFIX,googleadservices.com,广告拦截
  - GEOIP,CN,国内直连
  - DOMAIN-SUFFIX,openai.com,AI服务
  - DOMAIN-SUFFIX,anthropic.com,AI服务
  - DOMAIN-SUFFIX,github.com,AI服务
  - DOMAIN-SUFFIX,youtube.com,国外媒体
  - DOMAIN-SUFFIX,google.com,国外网站
  - DOMAIN-SUFFIX,twitter.com,国外网站
  - DOMAIN-SUFFIX,telegram.org,国外网站
  - GEOIP,!CN,国外网站
  - MATCH,TUIC代理
